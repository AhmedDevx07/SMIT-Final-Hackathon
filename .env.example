# ==============================================================
# MaintainIQ — Environment Variables Template
# ==============================================================

# Backend Port
PORT=5000

# MongoDB Connection String
# For local Docker MongoDB: mongodb://mongodb:27017/maintainiq
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/maintainiq?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/maintainiq

# JWT Secret for token generation
JWT_SECRET=super_secure_maintainiq_jwt_secret_key_2024

# Frontend URL
CLIENT_URL=http://localhost:5173

# Frontend API Endpoint
VITE_API_URL=http://localhost:5000/api

# Google Gemini / OpenAI API Key for AI Issue Triage
OPENAI_API_KEY=your_gemini_api_key_here
