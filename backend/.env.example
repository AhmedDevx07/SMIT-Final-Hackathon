# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB (used by Docker Compose): mongodb://mongodb:27017/maintainiq
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/maintainiq?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/maintainiq

# Authentication
JWT_SECRET=supersecretjwtkey_maintainiq_change_in_production

# Frontend Application URL (for CORS and QR URLs)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (for AI Issue Triage)
# Can also be named OPENAI_API_KEY in the current codebase
OPENAI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
